# ---------------------------------------------------------------------------
# Dardania | Elite — environment configuration
# Copy to .env and fill in. NEVER commit .env or real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Discord application ---------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# Application (client) ID — used by the bot and OAuth2
DISCORD_CLIENT_ID=
# Your Discord server (guild) ID
DISCORD_GUILD_ID=
# Optional: additional guild ids the bot may serve, comma separated
DISCORD_ALLOWED_GUILD_IDS=

# --- Discord OAuth2 (owner dashboard login) --------------------------------
# Uses DISCORD_CLIENT_ID above; only the secret is additional.
DISCORD_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect registered in the Discord developer portal
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/discord/callback

# --- Dashboard access policy (explicit allowlist, Discord user IDs) --------
DASHBOARD_OWNER_DISCORD_IDS=
DASHBOARD_CO_OWNER_DISCORD_IDS=
# Optional scoped access: may only view/annotate PC checks, never ban history
DASHBOARD_PC_CHECKER_DISCORD_IDS=

# --- Database --------------------------------------------------------------
# PostgreSQL in production:
# DATABASE_URL=postgres://user:password@host:5432/dardania_elite?sslmode=require
# SQLite for local development / tests:
DATABASE_URL=sqlite:./data/dev.sqlite
# Optional: path for automated pg_dump backups (scripts/backup-db.sh)
BACKUP_DIR=./backups

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8787
# Public origin of the API (used for CORS + cookie decisions)
API_BASE_URL=http://localhost:8787
# Comma separated list of allowed browser origins
WEB_ORIGIN=http://localhost:5173
# Serve the built SPA from the API (single-host production deployment)
SERVE_WEB=false
WEB_DIST_DIR=apps/web/dist

# --- Sessions & CSRF -------------------------------------------------------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Bot <-> API service authentication ------------------------------------
# Shared secret used by the bot for internal API calls. 32+ bytes.
SERVICE_TOKEN=
API_BASE_URL_INTERNAL=http://127.0.0.1:8787

# --- Steam -----------------------------------------------------------------
# https://steamcommunity.com/dev/apikey — backend only, never expose
STEAM_API_KEY=
STEAM_CACHE_TTL_SECONDS=300

# --- Public community configuration ---------------------------------------
PUBLIC_DISCORD_INVITE_URL=https://discord.gg/MsT96sPS3e
PUBLIC_SUPPORT_URL=
PUBLIC_CONTACT_EMAIL=
PUBLIC_STEAM_GROUP_URL=
PUBLIC_SERVERS=[]
PUBLIC_TEAM_JSON=[]

# --- Local development only ------------------------------------------------
# Never enable in production. Allows an allowlisted Discord ID to sign in
# without Discord OAuth while developing the dashboard locally.
ALLOW_DEV_LOGIN=false

# --- Public website / dashboard base URL (used in bot messages) ------------
WEB_BASE_URL=http://localhost:5173
# Path for the bot's durable local moderation-event outbox (gitignored data/)
BOT_OUTBOX_PATH=./data/bot-outbox.jsonl
