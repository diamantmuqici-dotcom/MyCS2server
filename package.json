{
  "name": "dardania-elite",
  "version": "1.0.0",
  "private": true,
  "description": "Dardania | Elite \u2014 CS2 community platform: website, Discord moderation bot, backend API, owner dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:bot": "tsx watch apps/bot/src/index.ts",
    "dev:web": "npm run dev -w @dardania/web",
    "start:api": "tsx apps/api/src/server.ts",
    "start:bot": "tsx apps/bot/src/index.ts",
    "build": "npm run build -w @dardania/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "db:promote-owner": "tsx scripts/promote-owner.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "register:commands": "npm run register-commands -w @dardania/bot"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "^18.0.8"
  }
}
